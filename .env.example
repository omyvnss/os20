# OS20 Configuration
# No configuration needed for local use!
# Just run: npx os20-cli

# Ports (avoid conflicts with other projects)
# Server: 3010
# PostgreSQL: 5433
# Redis: 6380

# AI Providers (optional - add your keys in Settings after launch)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=

# Ollama runs automatically if installed locally
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Generated once by install.sh / npx os20-cli. Never change APP_SECRET after the
# first start: it encrypts the API keys you save in Settings.
APP_SECRET=
PGDB_ENCRYPTION_KEY=
# Shared secret between the OS20 server and the lead engine sidecar
OS20_LEADGEN_TOKEN=

# Optional: let workflow HTTP steps reach private/host services (n8n, Ollama)
# OUTBOUND_HTTP_SAFE_MODE_ENABLED=false
