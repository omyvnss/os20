# OS20 Configuration
# No configuration needed for local use!
# Just run: npx os20-cli

# Ports: only the app is published, on 127.0.0.1:3010. PostgreSQL, Redis and
# the lead engine are reachable only inside the Docker network.

# AI Providers (optional - add your keys in Settings after launch)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=

# Ollama runs automatically if installed locally
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Generated once by install.sh / npx os20-cli. Never change APP_SECRET after the
# first start: it encrypts the API keys you save in Settings.
APP_SECRET=
PGDB_ENCRYPTION_KEY=
# Shared secret between the OS20 server and the lead engine sidecar. Required:
# the compose refuses to start without it, and install.sh / the CLI add it to an
# existing .env that is missing it.
OS20_LEADGEN_TOKEN=

# Optional: let workflow HTTP steps reach private/host services (n8n, Ollama)
# OUTBOUND_HTTP_SAFE_MODE_ENABLED=false
