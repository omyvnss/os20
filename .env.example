# OS20 Configuration
# No configuration needed for local use!
# Just run: npx os20

# Ports (avoid conflicts with other projects)
# Server: 3010
# Frontend: 3011
# PostgreSQL: 5433
# Redis: 6380

# AI Providers (optional - add your keys in Settings after launch)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=

# Ollama runs automatically if installed locally
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Generated secrets (auto-filled by installer if not set)
ACCESS_TOKEN_SECRET=
LOGIN_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
FILE_TOKEN_SECRET=
PGDB_ENCRYPTION_KEY=
APP_SECRET=
